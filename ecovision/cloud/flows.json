[
  {
    "id": "eco-tab",
    "type": "tab",
    "label": "EcoVision · server-owned state",
    "disabled": false,
    "info": "MQTT credentials stay in server config. Dashboard commands remain PENDING until terminal ACK."
  },
  {
    "id": "eco-tick",
    "type": "inject",
    "z": "eco-tab",
    "name": "Refresh freshness / ACK timeout",
    "props": [],
    "repeat": "1",
    "once": true,
    "onceDelay": 0.5,
    "x": 180,
    "y": 100,
    "wires": [
      [
        "eco-state"
      ]
    ]
  },
  {
    "id": "eco-state",
    "type": "function",
    "z": "eco-tab",
    "name": "Read cloud state",
    "func": "return {payload:global.get(\"eco\").view()};",
    "outputs": 1,
    "x": 440,
    "y": 100,
    "wires": [
      [
        "eco-widget"
      ]
    ]
  },
  {
    "id": "eco-widget",
    "type": "ui-template",
    "z": "eco-tab",
    "group": "eco-group",
    "page": "",
    "ui": "",
    "name": "Telemetry and ACK dashboard",
    "order": 1,
    "width": 12,
    "height": 0,
    "head": "",
    "format": "<template>\n  <section class=\"eco\" v-if=\"msg && msg.payload\">\n    <header><h1>EcoVision 绿智微视</h1><p>远程风扇控制</p></header>\n    <p role=\"alert\" v-if=\"msg.payload.error\">请求未发送：{{ msg.payload.error }}</p>\n    <article v-for=\"d in msg.payload.devices\" :key=\"d.device_id\">\n      <h2>{{ d.device_id }} <strong v-if=\"d.simulated\">模拟设备 · 非硬件实测</strong></h2>\n      <p>连接：{{ stale(d) ? 'STALE' : d.connection }} · 最后接收（UTC）：{{ d.last_received_at || '尚无数据' }}</p>\n      <p v-if=\"stale(d)\" role=\"alert\">数据已过期或尚无新鲜遥测，控制已禁用。</p>\n      <div class=\"values\" v-if=\"d.telemetry\">\n        <span>人数 <b>{{ d.telemetry.vision_valid ? d.telemetry.count : '无效' }}</b></span>\n        <span>温度 <b>{{ d.telemetry.temp_valid ? d.telemetry.temp_c + ' °C' : '无效' }}</b></span>\n        <span>湿度 <b>{{ d.telemetry.humidity_valid ? d.telemetry.humidity_pct + ' %RH' : '无效' }}</b></span>\n        <span>占用 {{ d.telemetry.occupancy }}</span><span>模式 {{ d.telemetry.mode }}</span>\n        <span>风扇输出 {{ d.telemetry.fan_out }} / LED输出 {{ d.telemetry.led_out }}</span>\n        <span>租期剩余 {{ d.telemetry.hold_remaining_s }} 秒</span>\n        <span>健康 {{ d.telemetry.faults.join(', ') || '无已报故障' }}</span>\n        <span>可信时间 {{ d.telemetry.time_valid ? '是' : '否' }} / epoch {{ d.telemetry.control_epoch }}</span>\n      </div>\n      <fieldset :disabled=\"!d.can_control || !socketReady() || stale(d) || waiting(d.device_id)\">\n        <legend>控制请求（本地关闭优先，由终端校验执行）</legend>\n        <button type=\"button\" @click=\"request(d, 1)\">开启风扇</button>\n        <button type=\"button\" @click=\"request(d, 0)\">关闭风扇</button>\n        <button type=\"button\" @click=\"request(d, null)\">恢复自动模式</button>\n        <p>手动控制持续 120 秒，期间按当前灯环输出设置灯环。</p>\n      </fieldset>\n      <p v-if=\"waiting(d.device_id)\">PENDING · 待终端确认，尚不能认定执行成功</p>\n      <p v-if=\"d.telemetry && d.telemetry.mode === 'LOCAL_OFF'\">终端本地关闭锁定，请在设备上短按解除。</p>\n    </article>\n    <h2>命令记录</h2><p>TIMEOUT = 10秒未收到 ACK，结果未知。已确认表示输出逻辑写入，不证明风扇机械转动。</p>\n    <div class=\"history\"><table><thead><tr><th>命令 ID / 设备</th><th>请求</th><th>结果</th></tr></thead>\n      <tbody><tr v-for=\"r in msg.payload.commands.slice(0, 20)\" :key=\"r.command.cmd_id\">\n        <td>{{ r.command.cmd_id }}<br>{{ r.command.device_id }}</td>\n        <td>{{ r.command.mode }} / 风扇 {{ r.command.fan_out }} / LED {{ r.command.led_out }}</td>\n        <td>{{ label(effectiveState(r)) }} {{ r.reason || '' }} {{ r.late ? '（迟到 ACK）' : '' }}</td>\n      </tr></tbody></table></div>\n  </section>\n</template>\n<script>\nexport default {\n  data() { return { submitting: {}, tick: performance.now(), received: performance.now(), timer: null } },\n  watch: { msg() { this.received = performance.now() } },\n  mounted() { this.timer = setInterval(() => { this.tick = performance.now() }, 500) },\n  unmounted() { clearInterval(this.timer) },\n  methods: {\n    socketReady() { return this.$socket && this.$socket.connected },\n    effectiveState(r) { return r.state === 'PENDING' && Math.max(0, this.tick - this.received) >= r.ack_remaining_ms ? 'TIMEOUT' : r.state },\n    stale(d) { return d.age_ms === null || d.age_ms + Math.max(0, this.tick - this.received) >= 15000 },\n    label(s) { return ({PENDING:'PENDING · 待确认', APPLIED:'APPLIED · 已确认', REJECTED:'REJECTED · 终端拒绝', TIMEOUT:'TIMEOUT · 结果未知'})[s] || s },\n    waiting(id) { return this.tick - (this.submitting[id] ?? -10000) < 1500 || this.msg.payload.commands.some(r => r.command.device_id === id && this.effectiveState(r) === 'PENDING') },\n    request(device, fan) {\n      const id = device.device_id\n      if (!this.socketReady() || !device.can_control || this.stale(device) || this.waiting(id)) return\n\n      // The contract requires an absolute setting for both outputs in REMOTE.\n      const intent = fan === null\n        ? { mode: 'AUTO' }\n        : { mode: 'REMOTE', fan_out: fan, led_out: device.telemetry.led_out }\n      this.submitting[id] = performance.now()\n      this.send({ payload: { device_id: id, intent } })\n    }\n  }\n}\n</script>\n<style>\n.eco { max-width:1100px; margin:auto; color:#163e34; padding:12px; font-family:system-ui,sans-serif }\n.eco header { border-bottom:3px solid #247d62; margin-bottom:18px }\n.eco article { padding:20px; margin:14px 0; border:1px solid #9bbbaf; border-radius:10px; background:#f4faf6 }\n.eco strong { display:inline-block; background:#fff0bb; color:#684c00; font-size:16px; padding:5px 9px }\n.eco .values { display:flex; gap:18px; flex-wrap:wrap; padding:16px 0 }\n.eco fieldset { display:flex; flex-wrap:wrap; gap:12px; padding:15px }\n.eco button { background:#17684f; color:white; padding:10px 16px; border:0; border-radius:5px; cursor:pointer }\n.eco fieldset:disabled { opacity:.45 }\n.eco .history { overflow:auto } .eco table { width:100%; border-collapse:collapse } .eco td,.eco th { border-bottom:1px solid #bbcfc5; padding:10px; text-align:left; overflow-wrap:anywhere }\n</style>\n",
    "storeOutMessages": false,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 700,
    "y": 100,
    "wires": [
      [
        "eco-command"
      ]
    ]
  },
  {
    "id": "eco-command",
    "type": "function",
    "z": "eco-tab",
    "name": "Validate intent / publish / PENDING",
    "func": "const eco=global.get(\"eco\");\ntry { eco.submit(msg.payload); return {payload:eco.view()}; } catch(e) { return {payload:{...eco.view(),error:e.message}}; }",
    "outputs": 1,
    "x": 700,
    "y": 200,
    "wires": [
      [
        "eco-widget"
      ]
    ]
  },
  {
    "id": "eco-base",
    "type": "ui-base",
    "name": "EcoVision",
    "path": "/dashboard",
    "appIcon": "",
    "includeClientData": true,
    "acceptsClientConfig": [],
    "showPathInSidebar": false,
    "showPageTitle": true,
    "navigationStyle": "default",
    "titleBarStyle": "default"
  },
  {
    "id": "eco-page",
    "type": "ui-page",
    "name": "设备与命令",
    "ui": "eco-base",
    "path": "/devices",
    "icon": "home",
    "layout": "grid",
    "theme": "eco-theme",
    "order": 1,
    "className": "",
    "visible": "true",
    "disabled": "false"
  },
  {
    "id": "eco-group",
    "type": "ui-group",
    "name": "EcoVision",
    "page": "eco-page",
    "width": 12,
    "height": 1,
    "order": 1,
    "showTitle": false,
    "visible": "true",
    "disabled": "false",
    "groupType": "default"
  },
  {
    "id": "eco-theme",
    "type": "ui-theme",
    "name": "EcoVision green",
    "colors": {
      "surface": "#ffffff",
      "primary": "#17684f",
      "bgPage": "#edf4ef",
      "groupBg": "#ffffff",
      "groupOutline": "#b7cdbf"
    },
    "sizes": {
      "density": "default",
      "pagePadding": "12px",
      "groupGap": "12px",
      "groupBorderRadius": "8px",
      "widgetGap": "12px"
    }
  }
]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ecovision:1.0.0:ack",
  "title": "ack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "device_id",
    "boot_id",
    "cmd_id",
    "status",
    "reason",
    "received_at",
    "uptime_ms",
    "control_epoch",
    "mode",
    "fan_out",
    "led_out",
    "hold_remaining_s"
  ],
  "properties": {
    "v": {
      "const": "1.0.0"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,32}$"
    },
    "cmd_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "status": {
      "enum": [
        "APPLIED",
        "REJECTED"
      ]
    },
    "reason": {
      "enum": [
        "OK",
        "INVALID_MESSAGE",
        "UNSUPPORTED_VERSION",
        "RETAINED_COMMAND",
        "BOOT_MISMATCH",
        "CMD_ID_CONFLICT",
        "TIME_UNTRUSTED",
        "FUTURE_COMMAND",
        "EXPIRED",
        "EPOCH_MISMATCH",
        "LOCAL_LOCKED",
        "BUSY"
      ]
    },
    "received_at": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "control_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "mode": {
      "enum": [
        "AUTO",
        "REMOTE",
        "LOCAL_OFF"
      ]
    },
    "fan_out": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "led_out": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "hold_remaining_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "fan_level": {
      "description": "Absolute fan setting. 0 is off, 1 through 5 are PWM levels.",
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    }
  },
  "dependentSchemas": {
    "fan_level": {
      "anyOf": [
        {
          "properties": {
            "fan_level": {
              "const": 0
            },
            "fan_out": {
              "const": 0
            }
          }
        },
        {
          "properties": {
            "fan_level": {
              "type": "integer",
              "minimum": 1
            },
            "fan_out": {
              "const": 1
            }
          }
        }
      ]
    }
  }
}

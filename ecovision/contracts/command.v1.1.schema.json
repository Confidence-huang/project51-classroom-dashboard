{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ecovision:1.1.0:command",
  "title": "command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "device_id",
    "boot_id",
    "control_epoch",
    "cmd_id",
    "issued_at",
    "ttl_s",
    "mode",
    "fan_out",
    "led_out",
    "hold_s"
  ],
  "properties": {
    "v": {
      "const": "1.1.0"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,32}$"
    },
    "control_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "cmd_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ttl_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "mode": {
      "enum": [
        "AUTO",
        "REMOTE"
      ]
    },
    "fan_out": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "led_out": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "hold_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "fan_level": {
      "description": "Absolute fan setting. 0 is off, 1 through 5 are PWM levels.",
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    }
  },
  "dependentSchemas": {
    "fan_level": {
      "anyOf": [
        {
          "properties": {
            "fan_level": {
              "const": 0
            },
            "fan_out": {
              "const": 0
            }
          }
        },
        {
          "properties": {
            "fan_level": {
              "type": "integer",
              "minimum": 1
            },
            "fan_out": {
              "const": 1
            }
          }
        }
      ],
      "properties": {
        "mode": {
          "const": "REMOTE"
        }
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "mode": {
          "const": "AUTO"
        }
      }
    },
    {
      "properties": {
        "mode": {
          "const": "REMOTE"
        },
        "fan_level": {}
      },
      "required": [
        "fan_level"
      ]
    }
  ]
}

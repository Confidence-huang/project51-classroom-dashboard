{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ecovision:1.2.0:command",
  "title": "command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "device_id",
    "boot_id",
    "control_epoch",
    "cmd_id",
    "issued_at",
    "ttl_s",
    "ac_temp_c"
  ],
  "properties": {
    "v": {
      "const": "1.2.0"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,32}$"
    },
    "control_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "cmd_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ttl_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "ac_temp_c": {
      "description": "Absolute demo setting: 0 is off, 16–30 requests on at that temperature.",
      "anyOf": [
        {
          "const": 0
        },
        {
          "type": "integer",
          "minimum": 16,
          "maximum": 30
        }
      ]
    }
  }
}
